.venv/
__pycache__/
.pytest_cache/
*.db
*.db-shm
*.db-wal
.env

.venv-wsl/
.test-temp*/
.env.*
.aws/
.ssh/
*.pem
*.key
.terraform/
*.tfstate*
*.tfplan
terraform.tfvars
*.auto.tfvars*

# Local notes and generated reports; do not publish.
/APPLICATION_GAPS.md
/DOCKER_VERIFICATION.json
/DOCKER_SCAN.md

.secrets/
backups/

/compose.override.yaml
/compose.override.yaml.tmp

# Database exports are never source artifacts.
**/*.sqlite*
**/*.dump
**/*.sql.gz
**/*.backup
**/*.sql
!app/canopy/migrations/*.sql

# Local runtime data; never publish database records.
/data/

# Terraform local inputs, CLI overrides and diagnostics are not source.
*.tfvars
*.tfvars.json
*.tfplan*
.terraformrc
terraform.rc
crash.log
crash.*.log
*.tfstate*
!*.tfvars.example
!*.tfvars.json.example

# Reusable child modules use the calling root provider lock file.
/infra/modules/**/.terraform.lock.hcl
