# Explicit source allowlist; app/ is the repository source root, not an image prefix.
**
!Dockerfile
!.dockerignore
!app/
!app/requirements.txt
!app/requirements-queue.txt
!app/requirements-analytics.txt
!app/canopy/
!app/canopy/**
!app/ingestion/
!app/ingestion/*.py
!app/analytics/
!app/analytics/*.py
!docker/
!docker/ingestion/
!docker/ingestion/Dockerfile
!docker/analytics/
!docker/analytics/Dockerfile
!docker/cloud-api/
!docker/cloud-api/Dockerfile
!docker/cloud-api/storage.py
!scripts/
!scripts/recovery/
!scripts/recovery/ledger.py
# Exclude credentials, local databases and development/build artifacts everywhere.
**/__pycache__/
**/*.py[cod]
**/.git/
**/.venv*/
**/venv/
**/.env
**/.env.*
**/.aws/
**/.ssh/
**/.secrets/
**/credentials
**/*.pem
**/*.key
**/.terraform/
**/*.tfstate*
**/*.tfplan
**/terraform.tfvars
**/*.auto.tfvars*
**/*.db*
**/*.log
**/dist/
**/build/
**/backups/
**/*.sqlite*
**/*.dump
**/*.sql.gz
**/*.backup
**/*.sql
!app/canopy/migrations/*.sql
