{
  "uid": "canopy-local",
  "title": "CanopyOps ? Local monitoring",
  "description": "Synthetic woodland station data. API metrics are not proof of worker health. Processing pipeline and cloud deployment remain outside this local milestone.",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "canopyops",
    "local",
    "synthetic"
  ],
  "panels": [
    {
      "id": 1,
      "title": "API scrape available",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "canopy-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"canopy-api\"}",
          "legendFormat": "{{station_id}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Database readable",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "canopy-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "canopy_storage_available{job=\"canopy-api\"}",
          "legendFormat": "{{station_id}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Reporting stations (<120s)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "canopy-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((time() - canopy_station_observed_timestamp_seconds{job=\"canopy-api\"}) < 120) or vector(0)",
          "legendFormat": "{{station_id}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "description": "Fresh latest observations, not proof that every event or retry is processed."
    },
    {
      "id": 4,
      "title": "Active environmental incidents (including stale stations)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "canopy-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(canopy_station_active_incidents{job=\"canopy-api\"}) or vector(0)",
          "legendFormat": "{{station_id}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "title": "API heartbeat age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "canopy-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(time() - canopy_heartbeat_timestamp_seconds{job=\"canopy-api\",service=\"api\"}, 0)",
          "legendFormat": "{{station_id}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 6,
      "title": "Temperature by station",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "canopy-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "canopy_station_temperature_celsius{job=\"canopy-api\"}",
          "legendFormat": "{{station_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Soil moisture by station",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "canopy-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "canopy_station_soil_moisture_percent{job=\"canopy-api\"}",
          "legendFormat": "{{station_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Reading age (stale after 120s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "canopy-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(time() - canopy_station_observed_timestamp_seconds{job=\"canopy-api\"}, 0)",
          "legendFormat": "{{station_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Humidity by station",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "canopy-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "canopy_station_humidity_percent{job=\"canopy-api\"}",
          "legendFormat": "{{station_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Latest state changes (1m)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "canopy-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(changes(canopy_station_observed_timestamp_seconds{job=\"canopy-api\"}[1m])) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "description": "Scrape-observed latest timestamp changes; not an event count. Duplicate and late events can be processed without changing latest state."
    },
    {
      "id": 11,
      "title": "Telemetry station series",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "canopy-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(canopy_station_observed_timestamp_seconds{job=\"canopy-api\"}) or vector(0)",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "description": "Expected four station series. Zero can indicate missing telemetry; inspect scrape availability before interpreting reading freshness."
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
