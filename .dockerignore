# Allow only the files needed by the image build.
**
!Dockerfile
!.dockerignore
!requirements.txt
!canopy/
!canopy/**
# Exclude these even if they appear inside the application directory.
**/__pycache__/
**/*.py[cod]
**/.git/
**/.venv*/
**/venv/
**/.env
**/.env.*
**/.aws/
**/.ssh/
**/credentials
**/*.pem
**/*.key
**/.terraform/
**/*.tfstate*
**/*.tfplan
**/terraform.tfvars
**/*.auto.tfvars*
**/*.db*
**/*.log
**/dist/
**/build/

**/.secrets/
**/backups/

# Database exports are never source artifacts.
**/*.sqlite*
**/*.dump
**/*.sql.gz
**/*.backup
**/*.sql
!canopy/migrations/*.sql

# Separate, explicit queue build inputs; no credentials or exports.
!requirements-queue.txt
!docker/
!docker/ingestion/
!docker/ingestion/Dockerfile
!ingestion/
!ingestion/*.py
!scripts/
!scripts/recovery/
!scripts/recovery/ledger.py
